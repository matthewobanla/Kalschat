DATABASE_URL=postgresql://kalschat:kalschat@localhost:5432/kalschat
# Optional direct/session-mode Postgres URL for LISTEN; defaults to DATABASE_URL.
DATABASE_LISTEN_URL=
# Generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:1515
INVITE_SHORT_URL=https://kalschat.cc
BYTESHIP_API_KEY=
BYTESHIP_MAX_UPLOAD_BYTES=26214400
BYTESHIP_USER_QUOTA_BYTES=1073741824

# Firebase Configuration (kalschat)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=kalschat.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=kalschat
VITE_FIREBASE_STORAGE_BUCKET=kalschat.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional GitHub login
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional Discord login
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Public analytics configuration, compiled into the browser bundle by Vite.
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Required for passwordless signup and sign-in codes.
# Use a verified sender domain and a live key for inbox delivery.
SENDBYTE_API_KEY=
SENDBYTE_FROM=Kalschat <hello@kalschat.app>
# Sentry DSNs are public project identifiers. Keep the auth token server-only.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
